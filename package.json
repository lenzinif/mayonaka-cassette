{
  "name": "mayonaka-cassette",
  "private": true,
  "version": "0.1.0-alpha",
  "description": "真夜中Cassette (Mayonaka Cassette) — A retro-futuristic driving flow-state game powered by Japanese Future Funk rhythms (Playable Alpha).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lenzinif.github.io/mayonaka-cassette/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lenzinif/mayonaka-cassette.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
